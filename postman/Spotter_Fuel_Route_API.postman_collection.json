        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Dallas, TX\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/optimize-route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "optimize-route", ""]
        },
        "description": "Verifies 400 Bad Request handling when payload is missing required fields."
      }
    },
    {
      "name": "6. Error - Location Outside USA",
      "request": {
