{
  "info": {
    "_postman_id": "spotter-fuel-router-api-v1",
    "name": "Spotter AI - Fuel Route Optimizer API",
    "description": "API collection for Spotter AI Backend Django hiring assessment. Optimizes driving routes and refueling stops under a 500-mile vehicle range constraint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Short Trip (Dallas, TX -> Houston, TX)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Dallas, TX\",\n  \"destination\": \"Houston, TX\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/optimize-route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "optimize-route", ""]
        },
        "description": "Demonstrates short route (<500 miles). Zero intermediate fuel stops needed; fuel consumption is accurately calculated and valued."
      }
    },
    {
      "name": "2. Medium Trip (Chicago, IL -> Atlanta, GA)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"Chicago, IL\",\n  \"destination\": \"Atlanta, GA\",\n  \"corridor_radius_miles\": 10.0\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/optimize-route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "optimize-route", ""]
        },
        "description": "Demonstrates medium route requiring 2 optimal refueling stops. Verifies leg distance <= 500 miles."
      }
    },
    {
      "name": "3. Cross-Country (New York, NY -> Los Angeles, CA)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origin\": \"New York, NY\",\n  \"destination\": \"Los Angeles, CA\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/optimize-route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "optimize-route", ""]
        },
        "description": "Demonstrates full cross-country route (~2,800 miles) with multiple optimal refueling stops and complete cost accounting."
      }
    },
    {
      "name": "4. Direct Coordinates Input (Start / Finish alias)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"32.7767, -96.7970\",\n  \"finish\": \"29.7604, -95.3698\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/optimize-route/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "optimize-route", ""]
        },
        "description": "Demonstrates passing coordinates directly (0 geocoding calls, 1 single routing API call)."
      }
    },
    {
