# Django Settings
DJANGO_SECRET_KEY=django-insecure-spotter-assessment-dev-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# External Routing Service (OSRM demo server or self-hosted)
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=10

# External Geocoding Service (Nominatim for origin/destination query resolution)
GEOCODING_USER_AGENT=SpotterFuelRouter/1.0 (assessment@spotter.ai)
GEOCODING_TIMEOUT_SECONDS=5

# Fuel Optimization Defaults
VEHICLE_MAX_RANGE_MILES=500.0
VEHICLE_FUEL_ECONOMY_MPG=10.0
VEHICLE_TANK_CAPACITY_GALLONS=50.0
ROUTE_CORRIDOR_RADIUS_MILES=10.0
